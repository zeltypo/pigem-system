# Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Azure Document Intelligence resource
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# OpenAI: required for full two-model screening; Azure remains the document reader
OPENAI_API_KEY=
OPENAI_QUALITY_MODEL=gpt-6.2-sol
OPENAI_QUALITY_EFFORT=medium
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=45

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=PIGEM Combined Facilities Support Services

# Google reCAPTCHA v2 checkbox
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Public site and server-only scheduler credential
APP_BASE_URL=
SCREENING_WORKER_SECRET=

# Optional; public map token. Without this, the existing map fallback is used.
LOCATIONIQ_API_KEY=
