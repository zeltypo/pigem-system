{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{web/**,pigem-system-duplicate/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(health|verify-captcha|screen-async|screen|notify|polite-remark)",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/web/html/index.html"
    },
    {
      "source": "/html/style.css",
      "destination": "/web/style.css"
    },
    {
      "source": "/html/js/(.*)",
      "destination": "/web/js/$1"
    },
    {
      "source": "/style.css",
      "destination": "/web/style.css"
    },
    {
      "source": "/js/(.*)",
      "destination": "/web/js/$1"
    },
    {
      "source": "/html/(.*)",
      "destination": "/web/html/$1"
    },
    {
      "source": "/(index|about|apply|privacy|login|activate|customer|staff-login|agent|manager|admin-login|admin|setup-accounts|agent-register|test)\\.html",
      "destination": "/web/html/$1.html"
    },
    {
      "source": "/(index|about|apply|privacy|login|activate|customer|staff-login|agent|manager|admin-login|admin|setup-accounts|agent-register|test)",
      "destination": "/web/html/$1.html"
    }
  ]
}
