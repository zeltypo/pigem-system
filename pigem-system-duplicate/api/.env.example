# Environment Variables Reference (Vercel Project Settings -> Environment Variables)
# Note: Never enable 'Sensitive' on non-secret URLs/hosts; keep Sensitive ON only for
# SUPABASE_ANON_KEY, GEMINI_API_KEY, RECAPTCHA_SECRET_KEY, and SMTP_PASSWORD.
APP_BASE_URL=https://pigem-system-web.vercel.app

# --- Supabase Cloud (PostgreSQL Database & Storage Buckets) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Google Gemini API (Multimodal ID Vision OCR & Polite Remarks) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Google reCAPTCHA v2 (Server-Side Token Verification) ---
RECAPTCHA_SECRET_KEY=

# --- Gmail SMTP (SSL/TLS Customer Emails Aligned With SMTP_USER) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_company_notifications@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=PIGEM Combined Facilities Support Services
SMTP_FROM_EMAIL=
