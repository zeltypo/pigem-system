# Environment Variables Reference (Configure these in Vercel Project Settings -> Environment Variables)
# Note: Leave "Sensitive" OFF for normal config variables; only enable "Sensitive" on secret keys
# (GEMINI_API_KEY, RECAPTCHA_SECRET_KEY, SMTP_PASSWORD). Never use a PUBLIC_ prefix for secret variables.

APP_BASE_URL=https://pigem-system-web.vercel.app

# --- Supabase Cloud (PostgreSQL, Auth, and Storage Buckets) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Google Gemini API (Vision OCR & Preliminary Screening Guidance) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Google reCAPTCHA v2 (Backend SiteVerify Secret Key) ---
RECAPTCHA_SECRET_KEY=

# --- Gmail SMTP (Encrypted TLS/SSL Customer Email Notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_company_notifications@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=PIGEM Support Services
SMTP_FROM_EMAIL=donotreply@pigem.ph
